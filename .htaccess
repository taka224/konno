DirectoryIndex index.php index.html

# 404 ページ
# パスはドメインのルートからの絶対パス。先頭の / は必須
# （無いと Apache がテキストメッセージとして解釈してしまう）。
# サブディレクトリ設置時は /sub/404.php のように書き換えること。
ErrorDocument 404 /404.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # www あり → www なしへ 301（正規 URL は www なし。sitemap/canonical と統一）
  # ロリポップで www の公開フォルダを本体と同じにした時点で有効になる
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # ルートで index.php を開いた場合は / へ（サブフォルダ設置時は index.php 内のリダイレクトが担当）
  RewriteCond %{THE_REQUEST} \s/+index\.php[\s?] [NC]
  RewriteRule ^index\.php$ / [R=301,L]
</IfModule>

# 静的ファイルの長期キャッシュ（クエリ ?v= で更新時にバusting）
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json image/svg+xml
</IfModule>
